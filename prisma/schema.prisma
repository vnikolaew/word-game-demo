generator client {
  provider = "prisma-client-js"
  output   = "generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  password      String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  isAdmin       Boolean   @default(false)
  accounts      Account[]
  sessions      Session[]

  metadata Json? @default("null")

  // Quiz related fields
  quizAttempts        QuizAttempt[]
  surveyResponses     DemographicSurvey[]
  consent             UserConsent[]
  wordListAssignments UserWordList[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Quiz related models
model Word {
  id         Int      @id @default(autoincrement())
  word       String // The actual word (item)
  isNonWord  Boolean // True if item_type is "nonword"
  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordListId Int

  @@index([wordListId])
}

model WordList {
  id              Int            @id @default(autoincrement())
  original_id     Int           @default(0)

  createdAt       DateTime       @default(now())
  timesUsed       Int            @default(0)
  lastUsedAt      DateTime?

  words           Word[]
  userAssignments UserWordList[]
  quizAttempts    QuizAttempt[]
}

model UserWordList {
  id         Int      @id @default(autoincrement())
  userId     String
  wordList   WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)
  wordListId Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, wordListId])
  @@index([userId])
}

model QuizAttempt {
  id                Int      @id @default(autoincrement())
  userId            String
  wordListId        Int
  score             Float
  correctWords      Int      @map("correct_words")
  incorrectWords    Int      @map("incorrect_words")
  correctNonWords   Int      @map("correct_non_words")
  incorrectNonWords Int      @map("incorrect_non_words")
  npxionTime        Int      @map("completion_time") // in milliseconds
  totalQuizDuration Int      @map("total_quiz_duration") // in milliseconds
  responses         Json // Array of responses
  createdAt         DateTime @default(now())
  deviceType        String   @map("device_type") // desktop, mobile, tablet
  deviceOS          String   @map("device_os")
  deviceBrowser     String   @map("device_browser")
  monitorSize       String   @map("monitor_size") // width x height
  viewportSize      String   @map("viewport_size") // width x height
  quizStatus        String   @map("quiz_status") // completed, dropped

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordList WordList @relation(fields: [wordListId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([wordListId])
}

model DemographicSurvey {
  id                        String   @id @default(cuid())
  userId                    String   @unique @map("user_id")

  nativeLanguage            String   @map("native_language")
  otherNativeLanguage       String?  @map("other_native_language")

  languageAcquisition       String   @map("language_acquisition")
  otherAcquisitionLanguage  String?  @map("other_acquisition_language")

  familyLanguage            String   @map("family_language")
  otherFamilyLanguage       String?  @map("other_family_language")

  gender                    String
  age                       String
  university                String?

  highestEducation          String   @map("highest_education")
  arabicDialect             String   @map("arabic_dialect")
  nationality               String
  otherNationality          String?  @map("other_nationality")

  residence                 String
  otherResidence            String?  @map("other_residence")

  languages                 String

  kindergartenLanguage      String   @map("kindergarten_language")
  otherKindergartenLanguage String?  @map("other_kindergarten_language")

  primaryLanguage           String   @map("primary_language")
  otherPrimaryLanguage      String?  @map("other_primary_language")

  middleLanguage            String   @map("middle_language")
  otherMiddleLanguage       String?  @map("other_middle_language")

  highSchoolLanguage        String   @map("high_school_language")
  otherHighSchoolLanguage   String?  @map("other_high_school_language")

  universityLanguage        String   @map("university_language")
  otherUniversityLanguage   String?  @map("other_university_language")

  readingHours              String   @map("reading_hours")
  listeningHours            String   @map("listening_hours")
  writingHours              String   @map("writing_hours")
  speakingHours             String   @map("speaking_hours")

  attentionDisorder         String   @map("attention_disorder")
  readingDisorder           String   @map("reading_disorder")
  vision                    String
  handedness                String

  createdAt                 DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserConsent {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  consentedAt    DateTime @map("consented_at")
  consentVersion String   @map("consent_version")
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
