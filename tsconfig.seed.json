{
  "compilerOptions": {
    "target": "ES2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "paths": {
      "@prisma/client": ["./prisma/generated/client"]
    }
  },
  "include": ["prisma/**/*.ts"],
  "exclude": ["node_modules"]
} 